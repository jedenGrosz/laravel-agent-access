{
  "name": "laravel-agent-access/laravel-agent-access",
  "description": "Explainable, controlled privilege grants for agents acting on behalf of Laravel users.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "illuminate/auth": "^12.69.0|^13.30.0",
    "illuminate/console": "^12.69.0|^13.30.0",
    "illuminate/database": "^12.69.0|^13.30.0",
    "illuminate/http": "^12.69.0|^13.30.0",
    "illuminate/routing": "^12.69.0|^13.30.0",
    "illuminate/support": "^12.69.0|^13.30.0",
    "illuminate/validation": "^12.69.0|^13.30.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/mcp": "^1.0.1",
    "laravel/pint": "^1.20",
    "laravel/sanctum": "^4.0",
    "orchestra/testbench": "^10.8|^11.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5.50",
    "spatie/laravel-permission": "^7.0|^8.0"
  },
  "suggest": {
    "laravel/mcp": "Enable MCP tools (^1.0.1).",
    "laravel/sanctum": "Authenticate the optional HTTP API.",
    "spatie/laravel-permission": "Resolve roles from an existing Spatie IAM."
  },
  "autoload": {
    "psr-4": {
      "LaravelAgentAccess\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LaravelAgentAccess\\AgentAccessServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G",
    "lint": "pint --test",
    "check": [
      "@test",
      "@analyse",
      "@lint"
    ],
    "demo:prepare": "testbench workbench:build",
    "demo": "testbench serve"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
